# Settings of the operator service (npm run operate / keeper / watch).
# Copy this file to indexer/.env for a local run, or set the same names in the host's secret store.
# Never commit the filled-in file, and never put a key behind a NEXT_PUBLIC_ name.

# RPC of the chain the vaults live on. It must serve historical logs and block headers.
INDEXER_RPC_URL=https://rpc.testnet.chain.robinhood.com
# Blocks a battle's or week's end must be buried under before its result is posted (~15 min at 0.23s blocks).
INDEXER_CONFIRMATIONS=4000

# Wallet the competition vault trusts as its operator (setOperator, through the admin timelock).
# It books battles and posts battle results and weekly winners. Keep only gas money in it.
OPERATOR_PRIVATE_KEY=
# A second wallet with no role anywhere. It pays for finalizing, buyback tranches, sweeps and expiry
# releases, which anyone may call. Keep only gas money in it.
KEEPER_PRIVATE_KEY=

# Slack or Discord incoming webhook for alerts. Leave empty to only log them.
ALERT_WEBHOOK_URL=

# Seconds between two passes.
OPERATOR_POLL_SECONDS=300
# From this UTC hour on, ready tokens are booked for the coming 00:00 UTC.
OPERATOR_BOOKING_HOUR_UTC=18
# A booking closer than this to midnight goes to the midnight after.
OPERATOR_MIN_BOOKING_LEAD_SECONDS=3600
# UTC time of the daily sweep of the fees the pool hook holds.
OPERATOR_SWEEP_AT_UTC=23:40
# Set to 1 to plan and simulate without sending anything.
OPERATOR_DRY_RUN=0

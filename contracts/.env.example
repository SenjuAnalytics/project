# RPC endpoint of the target chain (used by deploy scripts via `forge script --rpc-url $RPC_URL`).
# e.g. https://rpc.testnet.chain.robinhood.com (testnet 46630) or the mainnet node.
RPC_URL=

# Optional: RPC used ONLY by the fork tests (DeployQualyraFork / DeployQualyraFullFlowFork).
# Those tests are SKIPPED unless this is set — e.g. https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_RPC_URL=

# Uniswap v4 PoolManager on the target chain
POOL_MANAGER=

# Already-deployed QualyraFactory (read by DeploySwapRouter.s.sol when adding periphery)
QUALYRA_FACTORY=

# Timelock that will own the factory
QUALYRA_TIMELOCK=

# Admin Safe, receives the platform share of fees
QUALYRA_TREASURY=

# Operator Safe, publishes schedules and results
QUALYRA_OPERATOR=

# Guardian Safe, pauses prize contracts and vetoes results
QUALYRA_GUARDIAN=

# Optional: USDG token address to list as a pair asset
USDG=

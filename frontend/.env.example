# ─────────────────────────────────────────────────────────────────────────────
# Qualyra frontend env — copy to `.env.local` and fill in.
#
# RULE OF THUMB
#   NEXT_PUBLIC_*  → inlined into the BROWSER bundle. NEVER put a secret / API key here.
#   (no prefix)    → server-side only (route handlers, the ws-proxy). Safe for keys.
#
# Proxy-first design: every KEYED provider is reached through a proxy so the key stays
# server-side. Keyless public endpoints (dRPC, the official Robinhood RPC) may stay direct.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server-side RPC keys (used by app/api/rpc/route.ts) ──────────────────────
# Mainnet HTTP RPC. Browser calls hit same-origin /api/rpc, which forwards to these server-side.
RPC_MAINNET=
RPC_MAINNET_ZAN=
# Optional dedicated testnet HTTP RPC (falls back to the official public node when unset).
RPC_TESTNET=

# ── WebSocket proxy (scripts/ws-proxy.mjs) — server-side, keys never reach the browser ──
# Start it with:  node scripts/ws-proxy.mjs   (or `npm run dev:all` to run it with Next.js).
# Routes on one port: /testnet-alchemy, /testnet-uniblock (+ /testnet, /), and the mainnet scaffolds
# /mainnet-zan, /mainnet-alchemy, /mainnet-uniblock (+ /mainnet -> zan).
WS_PROXY_PORT=8546
#
# TESTNET (46630) — TWO providers (the browser falls back alchemy -> uniblock -> dRPC):
#  1) Alchemy testnet — key rides inside the URL, so no header. e.g. wss://robinhood-testnet.g.alchemy.com/v2/<KEY>
WS_PROXY_TESTNET_ALCHEMY_UPSTREAM=
WS_PROXY_TESTNET_ALCHEMY_KEY=
#  2) Uniblock testnet — key MUST go in the X-API-KEY header (a browser WS handshake can't send it).
WS_PROXY_TESTNET_UNIBLOCK_UPSTREAM=
WS_PROXY_TESTNET_UNIBLOCK_KEY=
#
# MAINNET (4663) — SCAFFOLD ONLY. Three provider slots (ZAN primary, then Alchemy, Uniblock), each on
# its own /mainnet-* proxy route, mirroring testnet. Leave empty until go-live; then paste the WSS
# upstream (+ key) for whichever you use. An empty upstream keeps that route disabled (the app falls
# back to the official mainnet HTTP RPC). Keys stay server-side — never in the browser bundle.
#  1) ZAN mainnet — key rides inside the URL. (Legacy WS_PROXY_MAINNET_UPSTREAM/KEY still honoured.)
WS_PROXY_MAINNET_ZAN_UPSTREAM=
WS_PROXY_MAINNET_ZAN_KEY=
#  2) Alchemy mainnet — key rides inside the URL, e.g. wss://robinhood-mainnet.g.alchemy.com/v2/<KEY>
WS_PROXY_MAINNET_ALCHEMY_UPSTREAM=
WS_PROXY_MAINNET_ALCHEMY_KEY=
#  3) Uniblock mainnet — key MUST go in the X-API-KEY header (the proxy injects it server-side).
WS_PROXY_MAINNET_UNIBLOCK_UPSTREAM=
WS_PROXY_MAINNET_UNIBLOCK_KEY=
#  Legacy generic mainnet slot (backwards compatibility; WS_PROXY_MAINNET_ZAN_* takes precedence).
WS_PROXY_MAINNET_UPSTREAM=
WS_PROXY_MAINNET_KEY=

# ── Client-exposed (safe: no secrets) — optional overrides read by frontend/lib/wagmi.ts ──
# Domain-based secure WebSocket (WSS) in production (e.g. wss://qualyra.com/ws).
# When set, frontend connects via your domain rather than localhost.
NEXT_PUBLIC_WSS_DOMAIN=
# Point the browser at the local WS proxy routes (defaults shown for local development).
# Testnet:
NEXT_PUBLIC_WSS_TESTNET_ALCHEMY_PROXY=
NEXT_PUBLIC_WSS_TESTNET_UNIBLOCK_PROXY=
NEXT_PUBLIC_WSS_TESTNET_PROXY=
# Mainnet — SCAFFOLD (browser tries zan -> alchemy -> uniblock -> official HTTP):
NEXT_PUBLIC_WSS_MAINNET_ZAN_PROXY=ws://localhost:8546/mainnet-zan
NEXT_PUBLIC_WSS_MAINNET_ALCHEMY_PROXY=ws://localhost:8546/mainnet-alchemy
NEXT_PUBLIC_WSS_MAINNET_UNIBLOCK_PROXY=ws://localhost:8546/mainnet-uniblock
NEXT_PUBLIC_WSS_MAINNET_PROXY=ws://localhost:8546/mainnet-zan
# Optional KEYLESS WSS fallbacks only. A keyed (Alchemy) URL here is rejected on purpose.
NEXT_PUBLIC_WSS_TESTNET=
NEXT_PUBLIC_WSS_MAINNET=
# Optional keyless Uniblock WSS fallback for testnet (used only if the proxy is down).
NEXT_PUBLIC_WSS_TESTNET_UNIBLOCK=

# WalletConnect project id (public by design).
NEXT_PUBLIC_WALLETCONNECT_ID=

# ── Pinata / IPFS (used by app/api/upload/route.ts) ──────────────────────────
# PINATA_JWT is server-side only (NO NEXT_PUBLIC_ prefix) — it uploads and must never be bundled.
PINATA_JWT=
# Public read gateway for fetching pinned files back (safe to expose).
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud

# ── App behaviour / display (public, no secrets) ─────────────────────────────
# Show testnet chains and default the wallet to testnet when 'true'.
NEXT_PUBLIC_ENABLE_TESTNETS=
# Dollars per ETH, DISPLAY ONLY (contracts have no oracle; testnet ETH has no market price).
NEXT_PUBLIC_ETH_USD_PRICE=3200
# Block the platform was deployed at — getLogs starts here instead of block 0 (most RPCs refuse 0).
NEXT_PUBLIC_QUALYRA_START_BLOCK=

# ── Qualyra platform contract addresses (public by design; read in frontend/lib/contracts.ts) ──
# Each of the nine platform contracts (+ periphery + Uniswap v4 PoolManager) is deployed once per
# chain. MAINNET vars have no suffix; TESTNET (chain 46630) vars use the _TESTNET suffix. Leaving a
# var empty falls back to NOT_DEPLOYED (0x000…000) on mainnet, or the baked-in testnet default.
#
# Mainnet (chain 4663)
NEXT_PUBLIC_QUALYRA_FACTORY=
NEXT_PUBLIC_QUALYRA_SWAP_ROUTER=
NEXT_PUBLIC_QUALYRA_LAUNCH_ROUTER=
NEXT_PUBLIC_QUALYRA_LAUNCH_DEPLOYER=
NEXT_PUBLIC_QUALYRA_HOOK=
NEXT_PUBLIC_QUALYRA_FEE_VAULT=
NEXT_PUBLIC_QUALYRA_COMPETITION_VAULT=
NEXT_PUBLIC_QUALYRA_GRADUATION_EXECUTOR=
NEXT_PUBLIC_QUALYRA_LIQUIDITY_LOCKER=
NEXT_PUBLIC_QUALYRA_BUYBACK_BURNER=
NEXT_PUBLIC_QUALYRA_POOL_MANAGER=
#
# Testnet (chain 46630) — code ships working defaults for these; override only to point elsewhere.
NEXT_PUBLIC_QUALYRA_FACTORY_TESTNET=
NEXT_PUBLIC_QUALYRA_SWAP_ROUTER_TESTNET=
NEXT_PUBLIC_QUALYRA_LAUNCH_ROUTER_TESTNET=
NEXT_PUBLIC_QUALYRA_LAUNCH_DEPLOYER_TESTNET=
NEXT_PUBLIC_QUALYRA_HOOK_TESTNET=
NEXT_PUBLIC_QUALYRA_FEE_VAULT_TESTNET=
NEXT_PUBLIC_QUALYRA_COMPETITION_VAULT_TESTNET=
NEXT_PUBLIC_QUALYRA_GRADUATION_EXECUTOR_TESTNET=
NEXT_PUBLIC_QUALYRA_LIQUIDITY_LOCKER_TESTNET=
NEXT_PUBLIC_QUALYRA_BUYBACK_BURNER_TESTNET=
NEXT_PUBLIC_QUALYRA_POOL_MANAGER_TESTNET=
